# Same as jni.def, but with `language = Objective-C` instead of `language.osx`.
#
# Keep in sync with jni.def: the `language` option is a plain string property and, unlike
# `compilerOpts`/`headers`, it is not substitutable, so `language.osx = ...` would be silently
# ignored and cinterop would preprocess the headers in C mode, hiding everything guarded by
# `#ifdef __OBJC__` (i.e. the JAWT_SurfaceLayers protocol) from the generated bindings.

headers = jni.h jni_md.h jawt.h jawt_md.h classfile_constants.h jdwpTransport.h jvmti.h jvmticmlr.h

# cinterop derives the package name from the def file name, so it has to be set explicitly here
# to keep the bindings in the same `jni` package as the other targets produce.
package = jni

compilerOpts = -I ./src/nativeInterop/cinterop/include
compilerOpts.linux = -I ./src/nativeInterop/cinterop/include/linux
compilerOpts.mingw = -I ./src/nativeInterop/cinterop/include/win32
compilerOpts.osx = -I ./src/nativeInterop/cinterop/include/darwin

language = Objective-C

userSetupHint = You need to have JVM dynamic libraries on the linker path to use JNI bindings. Use NativeBinary.linkerOpts("-L $JAVA_HOME/lib/server", "-l jvm") or NativeBinary.linkerOpts("-L $JAVA_HOME/lib", "-l jvm") on Windows to use JNI. For JAWT and others, you need libraries of the same name, they are located in $JAVA_HOME/lib.
---
typedef struct _jobject {} *jobject;
typedef struct _jfieldID {} *jfieldID;
typedef struct _jmethodID {} *jmethodID;
